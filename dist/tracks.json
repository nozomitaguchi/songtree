  {
    "id": "matane",
    "title": "またね",
    "createdYear": null,
    "datePrecision": "period",
    "displayPeriod": "ジャズを習い始めてから",
    "historyEventId": "jazz",
    "creationOrder": null,
    "audioVersionYear": null,
    "composer": "nozomitaguchi",
