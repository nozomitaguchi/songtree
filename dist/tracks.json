  {
    "id": "machiawase",
    "title": "待ち合わせ",
    "createdYear": null,
    "datePrecision": "period",
    "displayPeriod": "2005年（仮） / patalp",
    "historyEventId": "patalp",
    "creationOrder": null,
    "audioVersionYear": null,
    "composer": "nozomitaguchi",
    "lyricist": "nozomitaguchi",
    "lyricCreditStatus": "confirmed-by-user",
    "lyricsByOwner": true,
    "lyrics": "時計の針が上を向いて\nおもちゃ達がパレード始める\nいつも少し早くに来て\nそれを見上げてる\n\nいつの間にか後ろにいて\nわざと大きな声で「お待たせ」\nいつも気づかないんだから\nそう言って笑う\n\n話したいことが\nたくさんあったけれど\n君の顔を見たら\n忘れてしまった\n手をつないで歩けば\nどこに行っても楽しいけれど\n今日は何をしようか\nその言葉から始めよう\n\n今日は何が楽しかった\nいつも決まってする質問\n少し上を向いて答える\nその顔が好きだ\n\n話したいことがまだ\nたくさんあったけれど\n腕の中は心地いいな\n眠ってしまいそうだ\n\n手をつないでいいかな\nこれをすると落ち着くんだ\n明日も晴れかな\n寝息で答えた\n\n時計の針が上を向いて\nおもちゃ達がパレード始める\nいつも少し早くに来て\nそれを見上げてる\n\nガラスに映る僕の姿\nこっそり近づく君の姿\n楽しそうな君の顔を\n僕は見上げてる",
    "notesThen": null,
    "notesNow": null,
    "audioSrc": null,
    "sourceUrl": "https://suno.com/song/69ad1db7-d1cb-45ff-a274-cb1bb62c99fe",
    "art": "blue",
    "sample": false,
    "sourceTitle": "待ち合わせ",
    "lyricsRetrievalStatus": "retrieved-and-published",
    "displayYear": 2005,
    "displayYearStatus": "placeholder",
    "creatorCreditTags": [
