  {
    "id": "moonbow",
    "title": "moonbow",
    "createdYear": null,
    "datePrecision": "period",
    "displayPeriod": "高校時代",
    "historyEventId": "rock",
    "creationOrder": null,
    "audioVersionYear": null,
    "composer": "nozomitaguchi",
